{"about": "Rat Index (Oct 27, 2026): color the map per resident and by restaurant pest citations, open the full index, pick an area for the badge and copy its code, then open that area's own page.",
 "page": "chicago-rat-complaints/",
 "steps": [
  {"scroll": "#map"},
  {"click": "#ratmap .gm-seg label:nth-of-type(4)"},
  {"expect_text": "#ratmap .gm-leg", "contains": "per 1,000 residents"},
  {"click": "#ratmap path[data-n='6']", "force": true},
  {"expect_text": "#ratmap .gm-info", "contains": "Rat Index:", "screenshot": true},
  {"click": "#ratmap .gm-seg label:nth-of-type(5)"},
  {"expect_text": "#ratmap .gm-leg", "contains": "violation 38"},
  {"expect_text": "#ratmap .gm-info", "contains": "(violation 38)"},
  {"click": "#ratmap .gm-seg label:nth-of-type(6)"},
  {"expect_text": "#ratmap .gm-leg", "contains": "violation 56", "screenshot": true},
  {"expect_count": "#areas table.ri-t tbody tr", "eq": 77},
  {"expect_count": "#areas a[href$='rat-index.csv']", "eq": 1},
  {"click": "#areas details.rc-more-t summary"},
  {"expect_visible": "#areas details.rc-more-t table"},
  {"scroll": "#embed"},
  {"select": "#ri-area", "value": "edison-park"},
  {"expect_js": "document.getElementById('ri-code').value.indexOf('/chicago-rat-complaints/edison-park/badge.svg') > 0"},
  {"expect_js": "document.getElementById('ri-img').getAttribute('src') === 'edison-park/badge.svg'"},
  {"click": "#embed .ri-copy"},
  {"expect_js": "document.querySelector('#embed .ri-ok').textContent.length > 0", "screenshot": true},
  {"goto": "chicago-rat-complaints/edison-park/"},
  {"expect_text": "h1", "contains": "Edison Park"},
  {"expect_js": "document.querySelector('img#ri-img').naturalWidth > 0"},
  {"click": "#embed .ri-copy"},
  {"expect_js": "document.querySelector('#embed .ri-ok').textContent.length > 0", "screenshot": true}
 ]}
