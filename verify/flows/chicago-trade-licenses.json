{"about": "Chicago Trade License Finder: pick a trade and see only its section, back to all trades; the general contractor class picker gives the class, fee and insurance for a project value and demolition scope (Oct 27, 2026).",
 "page": "chicago-trade-licenses/",
 "steps": [
  {"expect_visible": "#lf-trade"},
  {"expect_text": "#lf-count", "matches": "^Showing all 12 trades$"},
  {"expect_count": ".lf-trade", "eq": 12},
  {"select": "#lf-trade", "value": "roofing", "screenshot": true},
  {"expect_text": "#lf-count", "matches": "^Showing 1 of 12 trades$"},
  {"expect_js": "[...document.querySelectorAll('.lf-trade')].filter(t=>getComputedStyle(t).display!=='none').map(t=>t.dataset.trade).join()==='roofing'"},
  {"expect_js": "location.hash==='#roofing'"},
  {"select": "#lf-trade", "value": ""},
  {"expect_text": "#lf-count", "matches": "^Showing all 12 trades$"},
  {"expect_js": "[...document.querySelectorAll('.lf-trade')].every(t=>getComputedStyle(t).display!=='none')"},
  {"expect_text": "#lf-cls", "matches": "^Class D$"},
  {"fill": "#lf-val", "value": "450000"},
  {"select": "#lf-demo", "value": "none"},
  {"expect_text": "#lf-cls", "matches": "^Class E$"},
  {"expect_text": "#lf-fee", "matches": "^\\$300 for the license$"},
  {"select": "#lf-demo", "value": "ordinary"},
  {"expect_text": "#lf-cls", "matches": "^Class D$"},
  {"expect_text": "#lf-why", "matches": "would fit Class E, but that class does not cover this demolition"},
  {"fill": "#lf-val", "value": "3,000,000"},
  {"select": "#lf-demo", "value": "complex"},
  {"expect_text": "#lf-cls", "matches": "^Class B$"},
  {"expect_text": "#lf-fee", "matches": "^\\$1,000 for the license$"},
  {"fill": "#lf-val", "value": "12m", "screenshot": true},
  {"expect_text": "#lf-cls", "matches": "^Class A$"},
  {"expect_text": "#lf-ren", "matches": "^\\$2,000 each year$"},
  {"expect_count": ".lf-t tr.on[data-cls='A']", "eq": 1},
  {"fill": "#lf-val", "value": "abc"},
  {"expect_text": "#lf-cls", "matches": "^Enter a value$"},
  {"expect_count": "#gc-class .lf-check a[href^='https://www.chicago.gov/']", "min": 1},
  {"click": ".lf-g a[data-go='plumbing']"},
  {"expect_text": "#lf-count", "matches": "^Showing 1 of 12 trades$"},
  {"expect_js": "[...document.querySelectorAll('.lf-trade')].filter(t=>getComputedStyle(t).display!=='none').map(t=>t.dataset.trade).join()==='plumbing'"},
  {"click": ".ld-heroact a[href='#gc-class']"},
  {"expect_visible": "#lf-val"},
  {"expect_js": "document.getElementById('lf-trade').value==='general-contractor'"},
  {"goto": "chicago-trade-licenses/general-contractor/"},
  {"expect_text": "h1", "matches": "Chicago"},
  {"expect_visible": "#lf-val"},
  {"expect_count": ".lf-check", "min": 2}
 ]}
