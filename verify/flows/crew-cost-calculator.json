{"about": "What a Chicago Crew Costs: the page opens on 2 electricians at the median; pick a trade and see its pay, switch to its Cook County public works rate, change the crew and see the crew day cost move; a bad entry shows a note, not a wrong number (Oct 27, 2026).",
 "page": "chicago-crew-cost/",
 "steps": [
  {"expect_text": "#cc-total", "matches": "^\\$892\\.58$"},
  {"expect_visible": "#cc-card-electricians"},
  {"select": "#cc-role", "value": "carpenters", "screenshot": true},
  {"expect_visible": "#cc-card-carpenters"},
  {"expect_js": "document.getElementById('cc-card-electricians').hidden === true"},
  {"expect_js": "document.getElementById('cc-rate').value === '38.68'"},
  {"select": "#cc-level", "value": "pw0"},
  {"expect_js": "document.getElementById('cc-rate').value === '58.51'"},
  {"expect_js": "!document.getElementById('cc-o-fr').closest('li').hidden"},
  {"fill": "#cc-crew", "value": "3"},
  {"fill": "#cc-hours", "value": "10", "screenshot": true},
  {"expect_text": "#cc-o-wl", "matches": "6 overtime hours"},
  {"fill": "#cc-crew", "value": "0"},
  {"expect_text": "#cc-total", "matches": "^Check the fields$"},
  {"expect_visible": ".cc-bad .cc-err"},
  {"fill": "#cc-crew", "value": "2"},
  {"select": "#cc-role", "value": "helpers:47-3012"},
  {"expect_visible": "[data-cc-line='helpers:47-3012']"},
  {"select": "#cc-role", "value": "janitors"},
  {"select": "#cc-level", "value": "p10"},
  {"expect_visible": "#cc-mwnote"},
  {"select": "#cc-level", "value": "median"},
  {"expect_hidden": "#cc-mwnote"},
  {"expect_count": "a[href*='contractor-hourly-rate-calculator']", "min": 1},
  {"expect_count": "a[href*='handyman-hourly-rate-calculator']", "min": 1}
 ]}
