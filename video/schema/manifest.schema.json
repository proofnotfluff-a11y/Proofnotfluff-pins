{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "pnf.video.manifest.v1",
 "title": "Render manifest (tools/video_render.py)",
 "type": "object",
 "required": [
  "schema",
  "videoId",
  "mp4",
  "sha256",
  "seconds",
  "lufs",
  "truePeak",
  "remotion",
  "node",
  "voiceFiles"
 ],
 "properties": {
  "schema": {
   "const": "pnf.video.manifest.v1"
  },
  "videoId": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}-rats-[a-z]$"
  },
  "mp4": {
   "type": "string"
  },
  "sha256": {
   "type": "string",
   "pattern": "^[0-9a-f]{64}$"
  },
  "seconds": {
   "type": "number"
  },
  "lufs": {
   "type": [
    "number",
    "null"
   ]
  },
  "truePeak": {
   "type": [
    "number",
    "null"
   ]
  },
  "remotion": {
   "const": "4.0.539"
  },
  "node": {
   "type": "string",
   "pattern": "^v22\\."
  },
  "voice": {
   "type": "object",
   "required": [
    "id",
    "name",
    "model",
    "test"
   ]
  },
  "voiceFiles": {
   "type": "array",
   "minItems": 2,
   "items": {
    "type": "object",
    "required": [
     "key",
     "file",
     "sha256",
     "seconds"
    ],
    "properties": {
     "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
     }
    }
   }
  },
  "specSha256": {
   "type": "string",
   "pattern": "^[0-9a-f]{64}$"
  },
  "propsSha256": {
   "type": "string",
   "pattern": "^[0-9a-f]{64}$"
  }
 }
}