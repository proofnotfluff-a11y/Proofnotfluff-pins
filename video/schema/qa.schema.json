{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "pnf.video.qa.v1",
 "title": "Gate 5 results (tools/video_qa.py)",
 "type": "object",
 "required": [
  "schema",
  "videoId",
  "mp4Sha256",
  "checks",
  "pass"
 ],
 "properties": {
  "schema": {
   "const": "pnf.video.qa.v1"
  },
  "videoId": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}-rats-[a-z]$"
  },
  "mp4Sha256": {
   "type": "string",
   "pattern": "^[0-9a-f]{64}$"
  },
  "pass": {
   "type": "boolean"
  },
  "checks": {
   "type": "array",
   "minItems": 10,
   "items": {
    "type": "object",
    "required": [
     "name",
     "value",
     "pass"
    ],
    "properties": {
     "name": {
      "type": "string"
     },
     "pass": {
      "type": "boolean"
     },
     "detail": {
      "type": "string"
     }
    }
   }
  }
 }
}