{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "pnf.video.review.v1",
 "title": "One fresh reviewer's verdict (video/reviews/<videoId>/<gate>.json)",
 "type": "object",
 "required": [
  "schema",
  "videoId",
  "gate",
  "model",
  "skillCommit",
  "inputs",
  "score",
  "pass",
  "reasons"
 ],
 "properties": {
  "schema": {
   "const": "pnf.video.review.v1"
  },
  "videoId": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}-rats-[a-z]$"
  },
  "gate": {
   "enum": [
    "facts",
    "hook-pick",
    "render-critic",
    "send",
    "buyer",
    "design",
    "golden"
   ]
  },
  "model": {
   "type": "string",
   "minLength": 3
  },
  "skillCommit": {
   "type": "string",
   "pattern": "^[0-9a-f]{7,40}$"
  },
  "prompt": {
   "type": "string"
  },
  "inputs": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "string"
   }
  },
  "score": {},
  "pass": {
   "type": "boolean"
  },
  "reasons": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "round": {
   "type": "integer",
   "minimum": 0,
   "maximum": 1
  },
  "at": {
   "type": "string"
  }
 }
}