{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "pnf.video.spec.v1",
 "title": "A Rat check video spec (video/specs/<videoId>.json)",
 "type": "object",
 "required": [
  "schema",
  "videoId",
  "template",
  "storyType",
  "picture",
  "evidence",
  "screen",
  "hooks",
  "hook",
  "lines",
  "cta",
  "endCard",
  "captions",
  "voice",
  "gates"
 ],
 "properties": {
  "schema": {
   "const": "pnf.video.spec.v1"
  },
  "videoId": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}-rats-[a-z]$"
  },
  "template": {
   "const": "rat-check"
  },
  "storyType": {
   "enum": [
    "A",
    "B",
    "C",
    "D"
   ]
  },
  "picture": {
   "enum": [
    "map",
    "bars",
    "line"
   ]
  },
  "slot": {
   "enum": [
    "Mon",
    "Wed",
    "Fri"
   ]
  },
  "evidence": {
   "type": "object",
   "required": [
    "file",
    "commit",
    "sha256",
    "numbers"
   ],
   "properties": {
    "file": {
     "type": "string"
    },
    "commit": {
     "type": "string"
    },
    "sha256": {
     "type": "string",
     "pattern": "^[0-9a-f]{64}$"
    },
    "numbers": {
     "type": "array",
     "minItems": 3,
     "items": {
      "type": "object",
      "required": [
       "id",
       "label",
       "path",
       "value",
       "shown"
      ],
      "properties": {
       "id": {
        "type": "string"
       },
       "label": {
        "type": "string"
       },
       "path": {
        "type": "string"
       },
       "value": {},
       "shown": {
        "type": "array",
        "items": {
         "type": "string"
        },
        "minItems": 1
       }
      }
     }
    }
   }
  },
  "screen": {
   "type": "object",
   "required": [
    "area",
    "headline",
    "chart",
    "compare"
   ]
  },
  "hooks": {
   "type": "array",
   "minItems": 3,
   "maxItems": 5,
   "items": {
    "type": "object",
    "required": [
     "say",
     "tts"
    ]
   }
  },
  "hook": {
   "type": "object",
   "required": [
    "say",
    "tts",
    "index"
   ]
  },
  "lines": {
   "type": "array",
   "minItems": 4,
   "maxItems": 10,
   "items": {
    "type": "object",
    "required": [
     "id",
     "scene",
     "say",
     "tts"
    ],
    "properties": {
     "scene": {
      "enum": [
       "hook",
       "picture",
       "compare",
       "why"
      ]
     },
     "say": {
      "type": "string",
      "minLength": 2
     },
     "tts": {
      "type": "string",
      "minLength": 2
     },
     "show": {
      "type": "array",
      "items": {
       "type": "string"
      }
     }
    }
   }
  },
  "cta": {
   "type": "object",
   "required": [
    "say"
   ]
  },
  "endCard": {
   "type": "object",
   "required": [
    "line",
    "path"
   ],
   "properties": {
    "path": {
     "const": "proofnotfluff.com/rats"
    }
   }
  },
  "captions": {
   "type": "object",
   "required": [
    "instagram"
   ],
   "properties": {
    "instagram": {
     "type": "string",
     "minLength": 40,
     "maxLength": 2200
    }
   }
  },
  "voice": {
   "type": "object",
   "required": [
    "model",
    "voiceIds"
   ],
   "properties": {
    "model": {
     "const": "eleven_v4"
    },
    "voiceIds": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "string"
     }
    }
   }
  },
  "music": {
   "type": "string"
  },
  "gates": {
   "type": "object"
  }
 }
}